diff --git a/crates/ui-egui/tests/it/viewer_mode.rs b/crates/ui-egui/tests/it/viewer_mode.rs
new file mode 100644
index 000000000..bb64e8469
--- /dev/null
+++ b/crates/ui-egui/tests/it/viewer_mode.rs
@@ -0,0 +1,299 @@
+//! Viewer mode (`view.viewer_mode`): a tabs-and-pages window for reading several PDFs. A button in
+//! the title bar, ⌘E (Ctrl+E) and the View menu turn it on; Esc, the strip's button and ⌘E turn it
+//! off. Its tabs close with their ×, a middle click, ⌘W and the tab's menu, and Ctrl+Tab steps
+//! through them.
+
+use egui::accesskit::Role;
+use egui::{Key, Modifiers};
+use egui_kittest::Harness;
+use egui_kittest::kittest::{NodeT, Queryable};
+use pdfcraft_ui_egui::PdfCraftApp;
+
+/// A one-page PDF.
+const PDF: &[u8] = b"%PDF-1.7
+1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj
+2 0 obj << /Type /Pages /Kids [3 0 R] /Count 1 >> endobj
+3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 400] >> endobj
+trailer << /Root 1 0 R >>
+%%EOF";
+
+fn harness(names: &[&'static str]) -> Harness<'static, PdfCraftApp> {
+    let names = names.to_vec();
+    let mut h = Harness::builder().with_size(egui::vec2(1400.0, 900.0)).build_eframe(move |_cc| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        for name in names {
+            app.open_bytes(name, None, PDF.to_vec()).expect("opens");
+        }
+        app
+    });
+    h.run_steps(4);
+    h
+}
+
+fn tab_names(h: &Harness<'static, PdfCraftApp>) -> Vec<String> {
+    let mut tabs: Vec<_> =
+        h.query_all_by_role(Role::Tab).map(|t| (t.rect().left(), t.accesskit_node().label().unwrap_or_default().to_string())).collect();
+    tabs.sort_by(|a, b| a.0.total_cmp(&b.0));
+    tabs.into_iter().map(|(_, name)| name).collect()
+}
+
+fn click_at(h: &mut Harness<'static, PdfCraftApp>, at: egui::Pos2) {
+    h.hover_at(at);
+    h.run_steps(1);
+    for pressed in [true, false] {
+        h.event(egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: Modifiers::NONE });
+        h.run_steps(1);
+    }
+    h.run_steps(2);
+}
+
+#[test]
+fn the_title_bar_button_the_shortcut_and_escape_switch_viewer_mode() {
+    let mut h = harness(&["a.pdf", "b.pdf"]);
+    assert!(!h.state().viewer_mode.enabled);
+    // The title bar's button.
+    h.get_by_label_contains("Viewer mode").click();
+    h.run_steps(3);
+    assert!(h.state().viewer_mode.enabled, "the title bar's button turns it on");
+    assert_eq!(tab_names(&h), ["a.pdf", "b.pdf"], "the tabs stay");
+    // Ctrl+E leaves it and enters it again.
+    h.key_press_modifiers(Modifiers::COMMAND, Key::E);
+    h.run_steps(3);
+    assert!(!h.state().viewer_mode.enabled, "Ctrl+E leaves it");
+    h.key_press_modifiers(Modifiers::COMMAND, Key::E);
+    h.run_steps(3);
+    assert!(h.state().viewer_mode.enabled, "and enters it");
+    // Esc leaves it.
+    h.key_press(Key::Escape);
+    h.run_steps(3);
+    assert!(!h.state().viewer_mode.enabled, "Esc leaves it");
+    // The strip's own button leaves it too.
+    h.state_mut().execute("view.viewer_mode");
+    h.run_steps(3);
+    h.get_by_label_contains("Leave viewer mode").click();
+    h.run_steps(3);
+    assert!(!h.state().viewer_mode.enabled, "the strip's button leaves it");
+}
+
+#[test]
+fn viewer_mode_tabs_close_and_step_with_the_keyboard() {
+    let mut h = harness(&["a.pdf", "b.pdf", "c.pdf"]);
+    h.state_mut().execute("view.viewer_mode");
+    h.run_steps(3);
+    assert_eq!(h.state().active, Some(2));
+    // Ctrl+Tab and Ctrl+Shift+Tab wrap around the tabs.
+    h.key_press_modifiers(Modifiers::CTRL, Key::Tab);
+    h.run_steps(3);
+    assert_eq!(h.state().active, Some(0), "Ctrl+Tab wraps to the first tab");
+    h.key_press_modifiers(Modifiers::CTRL | Modifiers::SHIFT, Key::Tab);
+    h.run_steps(3);
+    assert_eq!(h.state().active, Some(2), "Ctrl+Shift+Tab steps back");
+    // Ctrl+W closes the tab in front.
+    h.key_press_modifiers(Modifiers::COMMAND, Key::W);
+    h.run_steps(3);
+    assert_eq!(tab_names(&h), ["a.pdf", "b.pdf"]);
+    assert!(h.state().viewer_mode.enabled, "closing a tab stays in viewer mode");
+}
+
+#[test]
+fn viewer_mode_tabs_close_with_their_button_and_their_menu() {
+    let mut h = harness(&["a.pdf", "b.pdf", "c.pdf"]);
+    h.state_mut().execute("view.viewer_mode");
+    h.run_steps(3);
+    // The × sits 16 pt in from the tab's right edge.
+    let b = h.get_by_role_and_label(Role::Tab, "b.pdf").rect();
+    click_at(&mut h, egui::pos2(b.right() - 16.0, b.center().y));
+    assert_eq!(tab_names(&h), ["a.pdf", "c.pdf"], "the × closes its own tab");
+    assert!(h.state().viewer_mode.enabled);
+    h.get_by_role_and_label(Role::Tab, "a.pdf").click_secondary();
+    h.run_steps(2);
+    h.get_by_label("Close Tab").click();
+    h.run_steps(3);
+    assert_eq!(tab_names(&h), ["c.pdf"], "the tab's menu closes it");
+}
+
+#[test]
+fn viewer_mode_pages_turn_with_the_page_keys() {
+    let three = String::from_utf8(PDF.to_vec())
+        .unwrap()
+        .replace("/Kids [3 0 R] /Count 1", "/Kids [3 0 R 4 0 R 5 0 R] /Count 3")
+        .replace("trailer", "4 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 400] >> endobj\n5 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 300 400] >> endobj\ntrailer")
+        .into_bytes();
+    let mut h = Harness::builder().with_size(egui::vec2(1400.0, 900.0)).build_eframe(move |_cc| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        app.open_bytes("three.pdf", None, three).expect("opens");
+        app
+    });
+    h.run_steps(4);
+    h.state_mut().execute("view.viewer_mode");
+    h.run_steps(3);
+    let page = |h: &Harness<'static, PdfCraftApp>| h.state().views[0].current;
+    assert_eq!(page(&h), 0);
+    h.key_press(Key::End);
+    h.run_steps(3);
+    assert_eq!(page(&h), 2, "End goes to the last page");
+    h.key_press(Key::Home);
+    h.run_steps(3);
+    assert_eq!(page(&h), 0, "Home goes to the first page");
+}
+
+#[test]
+fn my_set_is_saved_in_settings_and_opens_together_in_viewer_mode() {
+    let dir = std::env::temp_dir().join(format!("pdfcraft-viewer-set-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let files: Vec<String> = ["a.pdf", "b.pdf"]
+        .iter()
+        .map(|n| {
+            let p = dir.join(n);
+            std::fs::write(&p, PDF).unwrap();
+            p.to_string_lossy().into_owned()
+        })
+        .collect();
+    let mut app = PdfCraftApp::new();
+    app.execute("view.viewer_set.open");
+    assert!(!app.viewer_mode.enabled, "no set yet: nothing happens");
+    for f in &files {
+        app.open_path(f);
+    }
+    app.execute("view.viewer_set.save");
+    assert_eq!(app.viewer_mode.set, files);
+    let settings = app.persist();
+
+    let mut later = PdfCraftApp::new();
+    later.restore(&settings);
+    later.open_path(&files[1]);
+    later.execute("view.viewer_set.open");
+    let open: Vec<String> = later.views.iter().filter_map(|v| later.session.get(v.id).and_then(|d| d.path.clone())).collect();
+    assert_eq!(open.len(), 2, "b.pdf, already open, is not opened twice");
+    assert!(open.contains(&files[0]) && open.contains(&files[1]));
+    assert!(later.viewer_mode.enabled, "the set opens in viewer mode");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn my_set_opens_at_startup_when_switched_on_and_no_file_was_named() {
+    let dir = std::env::temp_dir().join(format!("pdfcraft-viewer-set-start-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let a = dir.join("a.pdf");
+    std::fs::write(&a, PDF).unwrap();
+    let a = a.to_string_lossy().into_owned();
+    let mut app = PdfCraftApp::new();
+    app.viewer_mode.set = vec![a.clone()];
+    app.open_viewer_set_at_start(&[]);
+    assert!(app.views.is_empty(), "off by default");
+    app.execute("view.viewer_set.at_start");
+    let settings = app.persist();
+
+    let mut later = PdfCraftApp::new();
+    later.restore(&settings);
+    assert!(later.viewer_mode.at_start, "the switch is kept in settings");
+    later.open_viewer_set_at_start(&["/x/named.pdf".into()]);
+    assert!(later.views.is_empty(), "a file named at launch opens alone");
+    later.open_viewer_set_at_start(&[]);
+    assert_eq!(later.views.len(), 1);
+    assert!(later.viewer_mode.enabled, "and in viewer mode");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn entering_viewer_mode_puts_the_hidden_tool_down() {
+    let mut app = PdfCraftApp::new();
+    app.open_bytes("a.pdf", None, PDF.to_vec()).expect("opens");
+    app.quick_tool = pdfcraft_ui_egui::QuickTool::Hand;
+    app.execute("view.viewer_mode");
+    assert!(app.viewer_mode.enabled);
+    assert_eq!(app.quick_tool, pdfcraft_ui_egui::QuickTool::Select, "the tools are hidden, so none acts on a click");
+}
+
+#[test]
+fn saving_my_set_with_only_unsaved_tabs_keeps_the_set() {
+    let mut app = PdfCraftApp::new();
+    app.viewer_mode.set = vec!["/kept/a.pdf".into()];
+    app.open_bytes("new.pdf", None, PDF.to_vec()).expect("opens");
+    app.execute("view.viewer_set.save");
+    assert_eq!(app.viewer_mode.set, ["/kept/a.pdf"], "a tab with no file does not wipe the set");
+}
+
+#[test]
+fn my_set_brings_its_first_file_to_the_front_when_all_are_open() {
+    let dir = std::env::temp_dir().join(format!("pdfcraft-viewer-set-front-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let files: Vec<String> = ["a.pdf", "b.pdf"]
+        .iter()
+        .map(|n| {
+            let p = dir.join(n);
+            std::fs::write(&p, PDF).unwrap();
+            p.to_string_lossy().into_owned()
+        })
+        .collect();
+    let mut app = PdfCraftApp::new();
+    for f in &files {
+        app.open_path(f);
+    }
+    app.viewer_mode.set = files.clone();
+    app.active = None;
+    app.execute("view.viewer_set.open");
+    let front = app.active.and_then(|i| app.session.get(app.views[i].id)).and_then(|d| d.path.clone());
+    assert_eq!(front.as_deref(), Some(files[0].as_str()), "the set's first file, not its last");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn escape_under_full_screen_leaves_viewer_mode_alone() {
+    let mut h = harness(&["a.pdf"]);
+    h.state_mut().execute("view.viewer_mode");
+    h.state_mut().full_screen_escape_exits = false;
+    h.state_mut().apply_full_screen(true);
+    h.run_steps(3);
+    h.key_press(Key::Escape);
+    h.run_steps(3);
+    assert!(h.state().viewer_mode.enabled, "Esc under full screen is full screen's alone");
+}
+
+#[test]
+fn my_set_keeps_its_first_file_in_front_while_the_rest_open_in_the_background() {
+    let dir = std::env::temp_dir().join(format!("pdfcraft-viewer-set-bg-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    // More files than the open worker's queue (16) holds, so the last ones wait their turn.
+    let files: Vec<String> = (0..20)
+        .map(|n| {
+            let p = dir.join(format!("{n:02}.pdf"));
+            std::fs::write(&p, PDF).unwrap();
+            p.to_string_lossy().into_owned()
+        })
+        .collect();
+    let mut h = harness(&[]);
+    h.state_mut().viewer_mode.set = files.clone();
+    h.state_mut().execute("view.viewer_set.open");
+    for _ in 0..200 {
+        h.run_steps(1);
+        if h.state().views.len() == 20 {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    h.run_steps(3);
+    let app = h.state();
+    assert_eq!(app.views.len(), 20, "the whole set opened");
+    let front = app.active.and_then(|i| app.session.get(app.views[i].id)).and_then(|d| d.path.clone());
+    assert_eq!(front.as_deref(), Some(files[0].as_str()), "the set's first file, whichever opened last");
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn my_set_saves_from_the_home_tab() {
+    let dir = std::env::temp_dir().join(format!("pdfcraft-viewer-set-home-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let a = dir.join("a.pdf");
+    std::fs::write(&a, PDF).unwrap();
+    let a = a.to_string_lossy().into_owned();
+    let mut app = PdfCraftApp::new();
+    app.open_path(&a);
+    // Home in front: no active document, but a tab is open.
+    app.active = None;
+    assert!(app.execute("view.viewer_set.save"), "not refused for want of a document");
+    assert_eq!(app.viewer_mode.set, [a]);
+    let _ = std::fs::remove_dir_all(&dir);
+}
